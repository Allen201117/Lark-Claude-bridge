<?xml version="1.0" encoding="UTF-8"?>
<!-- 开机自启示例（可选）。用前把 YOUR_USERNAME 换成你的用户名，放到 ~/Library/LaunchAgents/。
     注意：若项目在 ~/Documents 等受保护目录，需给 /bin/bash 开「完全磁盘访问权限」，否则会 exit 126。 -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.feishu-claude-bridge</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/YOUR_USERNAME/path/to/feishu-claude-bridge/start.sh</string>
    </array>

    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/Users/YOUR_USERNAME/.feishu-claude-bridge/launchd.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/YOUR_USERNAME/.feishu-claude-bridge/launchd.err.log</string>
</dict>
</plist>
